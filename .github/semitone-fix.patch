 diff --git a/tests/e2e/push-pedal-fullpage.spec.js b/tests/e2e/push-pedal-fullpage.spec.js
new file mode 100644
index 0000000..378583a
--- /dev/null
+++ b/tests/e2e/push-pedal-fullpage.spec.js
@@ -0,0 +1,66 @@
+const { test, expect } = require('@playwright/test');
+
+// Only the physical MIDI transport is simulated. Load the real page, selected
+// preset, DOM handlers, async AudioWorklet with FDTD assets available; do not replace the
+// audio/voice code as the VM fixture does. This is not a physical Human Gate.
+test('full page routes Live-Port CC64 to e-piano PCM hold and release', async ({ page }) => {
+  const errors = [];
+  page.on('pageerror', error => errors.push(error.message));
+  await page.addInitScript(() => {
+    const input = { id: 'test-live', name: 'Ableton Push 3 Live Port', manufacturer: 'Ableton',
+      state: 'connected', connection: 'open', type: 'input', onmidimessage: null,
+      async open() { return this; }, async close() { return this; } };
+    const output = { ...input, id: 'test-out', type: 'output', send() {}, clear() {} };
+    const access = { inputs: new Map([[input.id, input]]), outputs: new Map([[output.id, output]]),
+      sysexEnabled: true, onstatechange: null, addEventListener() {}, removeEventListener() {} };
+    Object.defineProperty(navigator, 'requestMIDIAccess', { value: async () => access, configurable: true });
+    window.__testMidi = data => {
+      if (!input.onmidimessage) throw new Error('Live Port listener not bound');
+      input.onmidimessage({ data: new Uint8Array(data), timeStamp: performance.now() });
+    };
+  });
+  // External analytics/fonts/CDN samples are not part of this local e-piano
+  // test. All same-origin application scripts and FDTD assets load normally.
+  await page.route('**/*', route => {
+    const hostname = new URL(route.request().url()).hostname;
+    return ['localhost', '127.0.0.1'].includes(hostname) ? route.continue() : route.abort();
+  });
+  await page.goto('./?pushdiag=1', { waitUntil: 'load' });
+  await page.waitForFunction(() => typeof setSustain === 'function' && typeof initWebMIDI === 'function');
+  await page.evaluate(() => { dismissAudioOverlay(); selectSound('epiano:Rhodes DI'); });
+  await page.waitForFunction(() => _epw_initialized && audioCtx.state === 'running');
+  await page.evaluate(() => {
+    window.__testAnalyser = audioCtx.createAnalyser();
+    __testAnalyser.fftSize = 2048;
+    _epw_node.connect(__testAnalyser);
+    __testMidi([0xb0, 64, 127]);
+    __testMidi([0x90, 60, 100]);
+  });
+  await page.waitForTimeout(150);
+  await page.evaluate(() => __testMidi([0x80, 60, 0]));
+  await page.waitForTimeout(250);
+  const held = await page.evaluate(() => {
+    const pcm = new Float32Array(__testAnalyser.fftSize);
+    __testAnalyser.getFloatTimeDomainData(pcm);
+    return { rms: Math.sqrt(pcm.reduce((sum, x) => sum + x * x, 0) / pcm.length),
+      flags: [_midiSustainOn, _sustainOn, _epw_sustainOn], version: APP_VERSION,
+      preset: AudioState.presetKey, pedal: window.__64PE_PUSH_MIDI_DIAG__.lastPedal };
+  });
+  expect(held.version).toBe('1.8.0');
+  expect(held.preset).toBe('Rhodes DI');
+  expect(held.flags).toEqual([true, true, true]);
+  expect(Number.isFinite(held.rms)).toBe(true);
+  expect(held.rms).toBeGreaterThan(0.000001);
+  await page.evaluate(() => __testMidi([0xb0, 64, 0]));
+  await page.waitForTimeout(450);
+  const released = await page.evaluate(() => {
+    const pcm = new Float32Array(__testAnalyser.fftSize);
+    __testAnalyser.getFloatTimeDomainData(pcm);
+    return { rms: Math.sqrt(pcm.reduce((sum, x) => sum + x * x, 0) / pcm.length),
+      flags: [_midiSustainOn, _sustainOn, _epw_sustainOn] };
+  });
+  expect(released.flags).toEqual([false, false, false]);
+  expect(released.rms).toBeLessThan(held.rms * 0.1);
+  expect(errors).toEqual([]);
+  console.log(JSON.stringify({ held, released }));
+});
 diff --git a/tests/push-standalone-parity.cjs b/tests/push-standalone-parity.cjs
index 50d0a8e..e696b49 100644
--- a/tests/push-standalone-parity.cjs
+++ b/tests/push-standalone-parity.cjs
@@ -294,3 +294,27 @@ test('held pitch edits clamp MIDI bounds and never modify another slot',()=>{
   b.up(); b.slot(0,[0,3,7]); b.down(); b.cc(54);
   assert.deepEqual(b.read('PlainState.memory[0].midiNotes'),[0,0,0]);
 });
+
+test('Chord D-pad semitone keeps quality, tensions and slash bass instead of starting root entry', () => {
+  const b = browser();
+  b.run("AppState.mode='chord'; AppState.key=0; BuilderState.root=11; BuilderState.quality={name:'7',pcs:[0,4,7,10]}; BuilderState.tension={label:'9',pcs:[2]}; BuilderState.bass=6; BuilderState.step=2; BuilderState._fromDiatonic=true; BuilderState._diatonicScaleIdx=0; BuilderState._fromSecDom=true; BuilderState._secDomTargetIsMajor=true;");
+  const quality=b.read('BuilderState.quality'), tension=b.read('BuilderState.tension');
+  b.cc(45); // physical D-pad right
+  assert.deepEqual(b.read('BuilderState.quality'),quality,'semitone movement must not call the destructive root-selection action');
+  assert.deepEqual(b.read('BuilderState.tension'),tension);
+  assert.deepEqual(b.read('[BuilderState.root,BuilderState.bass,BuilderState.step,AppState.key]'),[0,7,2,0]);
+  assert.deepEqual(b.read('[BuilderState._fromDiatonic,BuilderState._fromSecDom]'),[false,false]);
+  b.cc(44); // physical D-pad left, including C/B wrap
+  assert.deepEqual(b.read('[BuilderState.root,BuilderState.bass,BuilderState.step]'),[11,6,2]);
+  assert.deepEqual(b.read('BuilderState.quality'),quality);
+  assert.deepEqual(b.read('BuilderState.tension'),tension);
+});
+
+test('Chord semitone is a completed-chord action, not an implicit root-entry cursor', () => {
+  const b=browser();
+  b.run("AppState.mode='chord'; BuilderState.root=2; BuilderState.quality=null; BuilderState.step=1;");
+  b.cc(45);
+  assert.equal(b.read('BuilderState.root'),2,'an incomplete chord must keep its selected root');
+  b.run('BuilderState.root=null;'); b.cc(44);
+  assert.equal(b.read('BuilderState.root'),null);
+});
